---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Post a Job — Media Planning Jobs"
  description="Hire media planners, buyers, ad ops, and programmatic talent. Specialist board reaching the discipline directly."
>
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-[clamp(36px,5vw,56px)] font-semibold leading-[1.02] tracking-display text-ink-950">Post a job</h1>
    <p class="mt-3 text-lg text-ink-600">
      Reach media planners, buyers, ad ops, and programmatic professionals directly. No resume-spam, no irrelevant applicants.
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      <div class="rounded-card border border-ink-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-ink-900">Standard listing</h2>
        <p class="mt-1 font-mono text-3xl font-medium text-ink-950">$99</p>
        <p class="mt-1 text-sm text-ink-500">30 days</p>
        <ul class="mt-4 space-y-2 text-sm text-ink-700">
          <li>✓ Listed on the homepage and category pages</li>
          <li>✓ Indexed in Google for Jobs (JobPosting schema)</li>
          <li>✓ Included in the weekly newsletter</li>
        </ul>
      </div>
      <div class="rounded-card border border-brand-line bg-brand-tint p-6">
        <h2 class="text-lg font-semibold text-ink-900">Featured</h2>
        <p class="mt-1 font-mono text-3xl font-medium text-ink-950">$299</p>
        <p class="mt-1 text-sm text-ink-500">30 days</p>
        <ul class="mt-4 space-y-2 text-sm text-ink-700">
          <li>✓ Pinned at the top of the homepage</li>
          <li>✓ Highlighted in the newsletter</li>
          <li>✓ Social post on launch</li>
          <li>✓ Everything in standard</li>
        </ul>
      </div>
    </div>

    <div class="mt-10 rounded-card border border-ink-200 bg-white p-6 text-sm text-ink-700">
      <p class="font-medium text-ink-900">Want to post?</p>
      <p class="mt-1">
        Email <a href="mailto:jobs@getmediaplanningjobs.com" class="font-medium text-brand hover:text-brand-dark">jobs@getmediaplanningjobs.com</a> with the role details and we'll get you live within 24 hours. Self-serve checkout coming soon.
      </p>
    </div>
  </section>
</BaseLayout>
