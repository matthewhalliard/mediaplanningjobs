---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Media Planning Jobs — Editorial",
  description:
    "Career guidance, salary data, and reporting on the media planning, buying, ad ops, and programmatic disciplines.",
  url: "https://getmediaplanningjobs.com/blog/",
  publisher: {
    "@type": "Organization",
    name: "Halliard",
    url: "https://halliardmedia.com",
  },
};
---
<BaseLayout
  title="Editorial — Career & Salary Guides for Media Professionals"
  description="Salary data, career path guides, and reporting on the media planning, buying, ad ops, and programmatic disciplines. Updated weekly."
  jsonLd={jsonLd}
>
  <section class="mx-auto flex max-w-site flex-col gap-8 px-6 pb-16 pt-12 sm:pt-16">
    <div class="flex flex-col gap-3">
      <p class="flex items-center gap-2.5 font-mono text-[13px] text-ink-600">
        <span class="h-2 w-2 rounded-full bg-brand" aria-hidden="true"></span>
        <span>{posts.length} guides · new posts weekly · <a href="/feed.xml" class="text-brand hover:text-brand-dark">RSS</a></span>
      </p>
      <h1 class="text-[clamp(36px,5vw,56px)] font-semibold leading-[1.02] tracking-display">Editorial</h1>
      <p class="max-w-[640px] text-[19px] leading-[1.55] text-ink-600">
        Career guides, salary data, and reporting for media professionals.
      </p>
    </div>

    {posts.length === 0 ? (
      <p class="text-ink-600">No posts yet — first one ships next week.</p>
    ) : (
      <div class="overflow-hidden rounded-card border border-ink-200 bg-white">
        {posts.map((p, i) => (
          <article class:list={["group relative flex flex-col gap-2 p-6 transition-colors hover:bg-ink-50 sm:flex-row sm:items-start sm:gap-8", i > 0 && "border-t border-ink-100"]}>
            <p class="shrink-0 font-mono text-[13px] text-ink-500 sm:w-32 sm:pt-1">{fmtDate(p.data.publishedAt)}</p>
            <div class="flex min-w-0 flex-1 flex-col gap-2">
              <h2 class="text-xl font-semibold tracking-[-0.02em] sm:text-[22px]">
                <a href={`/blog/${p.slug}/`} class="after:absolute after:inset-0 group-hover:text-brand">{p.data.title}</a>
              </h2>
              <p class="text-ink-600">{p.data.description}</p>
              <p class="font-mono text-xs text-ink-500">
                {p.data.author}{p.data.readingMinutes && ` · ${p.data.readingMinutes} min read`}
              </p>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

