---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ListingLanding from "../../../components/ListingLanding.astro";
import { CITY_INTROS, matchListingToCity, type CityIntro } from "../../../data/cityIntros";

export async function getStaticPaths() {
  return CITY_INTROS.map((intro) => ({
    params: { city: intro.urlSlug },
    props: { intro },
  }));
}

interface Props {
  intro: CityIntro;
}
const { intro } = Astro.props;

const allJobs = (await getCollection("jobs"))
  .filter((j) => {
    const matched = matchListingToCity(j.data.location, j.data.remote);
    return matched?.urlSlug === intro.urlSlug;
  })
  .sort((a, b) => b.data.postedAt.getTime() - a.data.postedAt.getTime());

const fmtSalary = (n: number) => `$${(n / 1000).toFixed(0)}K`;
const salaryRange = `${fmtSalary(intro.salaryBand.min)}\u2013${fmtSalary(intro.salaryBand.max)}`;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": canonical,
      url: canonical,
      name: intro.h1,
      description: intro.metaDescription,
      numberOfItems: allJobs.length,
    },
    {
      "@type": "FAQPage",
      mainEntity: intro.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: f.a,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: new URL("/", Astro.site).toString(),
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Jobs",
          item: new URL("/jobs/", Astro.site).toString(),
        },
        {
          "@type": "ListItem",
          position: 3,
          name: intro.label,
          item: canonical,
        },
      ],
    },
  ],
};
---
<BaseLayout
  title={intro.metaTitle}
  description={intro.metaDescription}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <ListingLanding
    crumb={intro.label}
    h1={intro.h1}
    countLabel={`${allJobs.length} open ${allJobs.length === 1 ? "role" : "roles"}`}
    salaryRange={salaryRange}
    salaryNote={intro.salaryBand.note}
    intro={intro.intro}
    listHeading={`Open ${intro.remoteBucket ? "remote" : intro.label} roles`}
    emptyLabel={intro.remoteBucket ? "remote" : intro.label}
    jobs={allJobs}
    employersHeading={`Top employers hiring ${intro.remoteBucket ? "remotely" : `in ${intro.label}`}`}
    topEmployers={intro.topEmployers}
    faqs={intro.faqs}
  />
</BaseLayout>

