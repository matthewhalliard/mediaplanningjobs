---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { FUNCTION_LABELS, LEVEL_LABELS, formatSalary } from "../../lib/format";

export async function getStaticPaths() {
  const jobs = await getCollection("jobs");
  return jobs.map((job) => ({ params: { slug: job.slug }, props: { job } }));
}

interface Props { job: CollectionEntry<"jobs">; }
const { job } = Astro.props;
const { Content } = await job.render();
const d = job.data;

// Convert raw MDX body to a sanitized HTML string for JSON-LD `description`.
// Google Jobs needs substantive description text — not just one line.
// We strip MDX-specific syntax and wrap paragraphs in <p>. Headings become <h3>,
// list items become <li>. Output is HTML-encoded for the JSON-LD field.
const toJsonLdHtml = (raw: string): string => {
  // Drop frontmatter (already gone from .body but defensive).
  const body = raw.replace(/^---[\s\S]*?---\s*/m, "").trim();
  if (!body) return `<p>${d.title} at ${d.company}, based in ${d.location}.</p>`;
  const lines = body.split(/\n/);
  const out: string[] = [];
  let inList = false;
  let para: string[] = [];
  const flushPara = () => {
    if (para.length) {
      out.push(`<p>${para.join(" ").trim()}</p>`);
      para = [];
    }
  };
  const closeList = () => {
    if (inList) {
      out.push("</ul>");
      inList = false;
    }
  };
  for (const ln of lines) {
    const t = ln.trim();
    if (!t) {
      flushPara();
      closeList();
      continue;
    }
    const h = t.match(/^(#{1,6})\s+(.+)$/);
    if (h) {
      flushPara();
      closeList();
      out.push(`<h3>${h[2]}</h3>`);
      continue;
    }
    const li = t.match(/^[-*]\s+(.+)$/);
    if (li) {
      flushPara();
      if (!inList) {
        out.push("<ul>");
        inList = true;
      }
      out.push(`<li>${li[1]}</li>`);
      continue;
    }
    para.push(t);
  }
  flushPara();
  closeList();
  // Strip residual markdown emphasis/links — keep plain text inside tags.
  return out
    .join("")
    .replace(/\*\*(.+?)\*\*/g, "$1")
    .replace(/\*(.+?)\*/g, "$1")
    .replace(/\[(.+?)\]\([^)]+\)/g, "$1");
};
const descriptionHtml = toJsonLdHtml(job.body || "");

const salary = formatSalary(d.salaryMin, d.salaryMax);

// Google JobPosting schema — required for Google Jobs eligibility.
const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "JobPosting",
  title: d.title,
  description: descriptionHtml,
  identifier: {
    "@type": "PropertyValue",
    name: "Media Planning Jobs",
    value: job.slug,
  },
  datePosted: d.postedAt.toISOString(),
  validThrough: new Date(d.postedAt.getTime() + 60 * 86400000).toISOString(),
  employmentType: d.employmentType,
  hiringOrganization: {
    "@type": "Organization",
    name: d.company,
    sameAs: d.companyUrl,
  },
  directApply: false,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
};

// Location handling for Google JobPosting schema.
// Adzuna feed gives us "City, County" (not state). We:
//   - Treat country-only or comma-less locations as nationwide remote (TELECOMMUTE),
//     which lets us omit jobLocation entirely (Google-compliant).
//   - Drop addressRegion when it's a county name (schema.org expects a state/region,
//     not a county; emitting a county here is invalid data).
const locParts = d.location.split(",").map((s) => s.trim()).filter(Boolean);
const isNationwide =
  locParts.length < 2 || /^(US|USA|United States|Remote)$/i.test(d.location);
if (isNationwide || d.remote === "remote") {
  jsonLd.jobLocationType = "TELECOMMUTE";
  jsonLd.applicantLocationRequirements = {
    "@type": "Country",
    name: "US",
  };
}
if (!isNationwide) {
  const locality = locParts[0];
  const regionRaw = locParts[1];
  const region =
    regionRaw && !/county$/i.test(regionRaw) ? regionRaw : undefined;
  const address: Record<string, string> = {
    "@type": "PostalAddress",
    addressLocality: locality,
    addressCountry: "US",
  };
  if (region) address.addressRegion = region;
  jsonLd.jobLocation = {
    "@type": "Place",
    address,
  };
}
if (d.salaryMin || d.salaryMax) {
  jsonLd.baseSalary = {
    "@type": "MonetaryAmount",
    currency: "USD",
    value: {
      "@type": "QuantitativeValue",
      minValue: d.salaryMin,
      maxValue: d.salaryMax,
      unitText: "YEAR",
    },
  };
}
---
<BaseLayout
  title={`${d.title} at ${d.company} — ${d.location}`}
  description={`${d.title} role at ${d.company}, ${d.location}. Apply now on Media Planning Jobs.`}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-site px-6 pb-16 pt-10">
    <nav class="font-mono text-[13px] text-ink-500" aria-label="Breadcrumb">
      <a href="/jobs/" class="hover:text-ink-950">← All jobs</a>
    </nav>
    <div class="mt-6 grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div class="min-w-0">
        <header class="flex flex-col gap-4 border-b border-ink-200 pb-8">
          <div class="flex items-center gap-3">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[10px] bg-ink-100 font-semibold" aria-hidden="true">{d.company.trim().charAt(0).toUpperCase()}</span>
            <p class="text-[17px] text-ink-600">
              <span class="font-medium text-ink-950">{d.company}</span>
              <span> · {d.location}</span>
              {d.remote !== "onsite" && <span class="capitalize"> · {d.remote}</span>}
            </p>
          </div>
          <h1 class="text-[clamp(32px,4.5vw,52px)] font-semibold leading-[1.04] tracking-display">{d.title}</h1>
          <div class="flex flex-wrap gap-1.5 text-xs">
            <span class="rounded-md bg-brand-tint px-2 py-1 text-brand-dark">{FUNCTION_LABELS[d.function] ?? d.function}</span>
            <span class="rounded-md bg-ink-100 px-2 py-1 text-ink-700">{LEVEL_LABELS[d.level] ?? d.level}</span>
          </div>
          <div class="flex flex-wrap items-center justify-between gap-3 pt-2 lg:hidden">
            <span class:list={["font-mono text-xl font-medium", salary ? "text-ink-950" : "text-ink-400"]}>{salary ?? "Salary not listed"}</span>
            <a
              href={d.applyUrl}
              target="_blank"
              rel="noopener nofollow"
              class="flex h-11 items-center justify-center rounded-[10px] bg-ink-950 px-5 font-medium text-white"
            >Apply ↗</a>
          </div>
        </header>
        <div class="job-body mt-8 text-ink-700">
          <Content />
        </div>
        <p class="mt-10 rounded-card border border-ink-200 bg-white p-5 text-sm text-ink-600">
          Listing aggregated from {d.source ?? "public sources"}. Apply directly on the employer's site.
        </p>
      </div>
      <aside class="lg:sticky lg:top-6 lg:self-start">
        <div class="flex flex-col gap-5 rounded-card border border-ink-200 bg-white p-6">
          <div class="flex flex-col gap-1">
            <span class="font-mono text-xs uppercase tracking-[0.04em] text-ink-500">Salary</span>
            <span class:list={["font-mono text-2xl font-medium", salary ? "text-ink-950" : "text-ink-400"]}>{salary ?? "Not listed"}</span>
          </div>
          <dl class="flex flex-col gap-2 border-t border-ink-100 pt-4 text-sm">
            <div class="flex justify-between gap-4"><dt class="text-ink-600">Posted</dt><dd class="font-mono text-[13px]">{d.postedAt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-ink-600">Type</dt><dd class="font-mono text-[13px]">{d.employmentType.replace("_", " ").toLowerCase()}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-ink-600">Workplace</dt><dd class="font-mono text-[13px] capitalize">{d.remote}</dd></div>
          </dl>
          <a
            href={d.applyUrl}
            target="_blank"
            rel="noopener nofollow"
            class="flex h-12 items-center justify-center rounded-[10px] bg-ink-950 px-5 font-medium text-white transition-colors hover:bg-ink-800"
          >
            Apply on employer site ↗
          </a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .job-body { font-size: 1.0625rem; line-height: 1.7; }
  .job-body > * + * { margin-top: 1em; }
  .job-body h2, .job-body h3 { color: #0C0A09; font-weight: 600; letter-spacing: -0.02em; margin-top: 1.75em; }
  .job-body h2 { font-size: 1.375rem; }
  .job-body h3 { font-size: 1.15rem; }
  .job-body ul { list-style: disc; padding-left: 1.4rem; }
  .job-body ol { list-style: decimal; padding-left: 1.4rem; }
  .job-body li + li { margin-top: 0.4em; }
  .job-body a { color: #047857; text-decoration: underline; text-underline-offset: 3px; }
  .job-body strong { color: #0C0A09; font-weight: 600; }
</style>

