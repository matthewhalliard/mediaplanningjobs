---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ListingLanding from "../../../components/ListingLanding.astro";
import { FUNCTION_INTROS, type FunctionIntro } from "../../../data/functionIntros";

export async function getStaticPaths() {
  return FUNCTION_INTROS.map((intro) => ({
    params: { function: intro.urlSlug },
    props: { intro },
  }));
}

interface Props {
  intro: FunctionIntro;
}
const { intro } = Astro.props;

const allJobs = (await getCollection("jobs"))
  .filter((j) => j.data.function === intro.slug)
  .sort((a, b) => b.data.postedAt.getTime() - a.data.postedAt.getTime());

const fmtSalary = (n: number) => `$${(n / 1000).toFixed(0)}K`;
const salaryRange = `${fmtSalary(intro.salaryBand.min)}–${fmtSalary(intro.salaryBand.max)}`;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();

// ViewContent (Meta). Page attributes only, no personal data.
const viewContent = {
  content_name: intro.label,
  content_category: intro.slug,
  content_type: "job_listing_page",
  site: "getmediaplanningjobs",
};

// Combined JSON-LD graph: FAQPage + CollectionPage + BreadcrumbList.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": canonical,
      url: canonical,
      name: intro.h1,
      description: intro.metaDescription,
      numberOfItems: allJobs.length,
    },
    {
      "@type": "FAQPage",
      mainEntity: intro.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: f.a,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: new URL("/", Astro.site).toString(),
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Jobs",
          item: new URL("/jobs/", Astro.site).toString(),
        },
        {
          "@type": "ListItem",
          position: 3,
          name: intro.h1,
          item: canonical,
        },
      ],
    },
  ],
};
---
<BaseLayout
  title={intro.metaTitle}
  description={intro.metaDescription}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <script is:inline define:vars={{ viewContent }}>
    if (window.fbq) window.fbq("track", "ViewContent", viewContent);
  </script>
  <ListingLanding
    crumb={intro.label}
    h1={intro.h1}
    countLabel={`${allJobs.length} open ${intro.label.toLowerCase()} ${allJobs.length === 1 ? "role" : "roles"}`}
    salaryRange={salaryRange}
    intro={intro.intro}
    listHeading={`Open ${intro.label} Roles`}
    emptyLabel={intro.label.toLowerCase()}
    jobs={allJobs}
    employersHeading={`Top employers hiring ${intro.label.toLowerCase()}`}
    topEmployers={intro.topEmployers}
    faqs={intro.faqs}
  />
</BaseLayout>

