---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import JobCard from "../components/JobCard.astro";
import JobList from "../components/JobList.astro";
import { FUNCTION_INTROS } from "../data/functionIntros";
import { CITY_INTROS, matchListingToCity } from "../data/cityIntros";

const jobs = (await getCollection("jobs"))
  .sort((a, b) => b.data.postedAt.getTime() - a.data.postedAt.getTime());

const byFunction = Object.fromEntries(
  FUNCTION_INTROS.map((f) => [f.slug, jobs.filter((j) => j.data.function === f.slug).length]),
);

const byCity = Object.fromEntries(
  CITY_INTROS.map((c) => [
    c.urlSlug,
    jobs.filter((j) => matchListingToCity(j.data.location, j.data.remote)?.urlSlug === c.urlSlug).length,
  ]),
);

const featured = jobs.filter((j) => j.data.featured).slice(0, 3);
const recent = jobs.filter((j) => !j.data.featured).slice(0, 12);

// Discipline pill set — covers ALL function values so counts add up to total.
const pills = [
  { label: "Planning",      slug: "media-planner",   func: "planning" },
  { label: "Buying",        slug: "media-buyer",     func: "buying" },
  { label: "Programmatic",  slug: "programmatic",    func: "programmatic" },
  { label: "Ad Ops",        slug: "ad-operations",   func: "ad-ops" },
  { label: "Analytics",     slug: "media-analyst",   func: "analytics" },
  { label: "Strategy",      slug: "media-strategy",  func: "strategy" },
  { label: "Leadership",    slug: "media-director",  func: "leadership" },
].map((p) => ({
  ...p,
  count: jobs.filter((j) => j.data.function === p.func).length,
})).sort((a, b) => b.count - a.count);

const roleCards = [...FUNCTION_INTROS].sort((a, b) => byFunction[b.slug] - byFunction[a.slug]);
const k = (n: number) => `$${Math.round(n / 1000)}K`;

// Schema.org @graph: lets us declare WebSite + Organization as related
// entities, with cross-references. LLMs and answer engines use this to
// build a clean entity graph for our brand.
const SITE_URL = "https://getmediaplanningjobs.com";
const ORG_ID = `${SITE_URL}/#organization`;
const PUBLISHER_ID = "https://halliardmedia.com/#organization";
const WEBSITE_ID = `${SITE_URL}/#website`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": ORG_ID,
      name: "Media Planning Jobs",
      alternateName: "getmediaplanningjobs.com",
      url: SITE_URL,
      logo: `${SITE_URL}/logo.svg`,
      description:
        "The specialist job board for media planners, media buyers, ad operations, and programmatic professionals in the United States.",
      parentOrganization: { "@id": PUBLISHER_ID },
      sameAs: [
        "https://halliardmedia.com",
        "https://mediaplanningtool.com",
      ],
    },
    {
      "@type": "Organization",
      "@id": PUBLISHER_ID,
      name: "Halliard",
      url: "https://halliardmedia.com",
      sameAs: [
        "https://halliardmedia.com",
        "https://mediaplanningtool.com",
        "https://getmediaplanningjobs.com",
      ],
    },
    {
      "@type": "WebSite",
      "@id": WEBSITE_ID,
      name: "Media Planning Jobs",
      url: SITE_URL,
      publisher: { "@id": ORG_ID },
      inLanguage: "en-US",
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${SITE_URL}/jobs?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    },
  ],
};
---
<BaseLayout
  title="Media Planning Jobs — Planner, Buyer, Ad Ops & Programmatic Roles"
  description="The specialist job board for media planners, media buyers, ad operations, and programmatic professionals. New roles every week. Built by Halliard."
  jsonLd={jsonLd}
>
  <section class="mx-auto flex max-w-site flex-col gap-7 px-6 pb-12 pt-14 sm:pt-[88px]">
    <p class="flex items-center gap-2.5 font-mono text-[13px] text-ink-600">
      <span class="h-2 w-2 rounded-full bg-brand" aria-hidden="true"></span>
      <span>{jobs.length} open roles · refreshed every weekday</span>
    </p>
    <h1 class="max-w-[960px] text-[clamp(44px,6vw,76px)] font-semibold leading-[0.98] tracking-display">
      Jobs for media planners, buyers and ad ops.
    </h1>
    <p class="max-w-[640px] text-[19px] leading-[1.55] text-ink-600">
      Roles across planning, buying, programmatic, ad ops and analytics, pulled from real agency and brand career pages with the salary range up front.
    </p>
    <form action="/jobs/" method="get" role="search" class="flex max-w-[820px] flex-wrap gap-2 rounded-2xl border border-ink-300 bg-white p-2">
      <label class="flex h-[52px] min-w-0 flex-[2_1_260px] items-center gap-2.5 px-3">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#78716C" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20 L16 16"></path></svg>
        <span class="sr-only">Role, skill or company</span>
        <input type="search" name="q" placeholder="Role, skill or company" class="min-w-0 flex-1 bg-transparent text-[17px] outline-none placeholder:text-ink-500" />
      </label>
      <label class="flex h-[52px] min-w-0 flex-[1_1_200px] items-center gap-2.5 border-ink-200 px-3 max-sm:border-t sm:border-l">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#78716C" stroke-width="2" aria-hidden="true"><path d="M12 21 C12 21 5 14.5 5 9.5 A7 7 0 0 1 19 9.5 C19 14.5 12 21 12 21 Z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
        <span class="sr-only">City or remote</span>
        <input type="text" name="loc" placeholder="City or remote" class="min-w-0 flex-1 bg-transparent text-[17px] outline-none placeholder:text-ink-500" />
      </label>
      <button type="submit" class="h-[52px] rounded-[10px] bg-ink-950 px-6 text-base font-medium text-white transition-colors hover:bg-ink-800 max-sm:w-full">Search jobs</button>
    </form>
    <div class="flex flex-wrap gap-2">
      {pills.map((p) => (
        <a
          href={`/jobs/function/${p.slug}/`}
          class="flex h-9 items-center gap-1.5 rounded-full border border-ink-200 bg-white px-3.5 text-sm text-ink-950 transition-colors hover:border-ink-950"
        >
          {p.label} <span class="font-mono text-ink-500">{p.count}</span>
        </a>
      ))}
    </div>
  </section>

  {featured.length > 0 && (
    <section class="mx-auto flex max-w-site flex-col gap-5 px-6 pt-6">
      <h2 class="text-[28px] font-semibold tracking-heading">Featured roles</h2>
      <JobList>
        {featured.map((j) => (
          <JobCard
            href={`/jobs/${j.slug}/`}
            title={j.data.title}
            company={j.data.company}
            location={j.data.location}
            remote={j.data.remote}
            func={j.data.function}
            level={j.data.level}
            salaryMin={j.data.salaryMin}
            salaryMax={j.data.salaryMax}
            postedAt={j.data.postedAt}
            featured={true}
          />
        ))}
      </JobList>
    </section>
  )}

  <section class="mx-auto flex max-w-site flex-col gap-5 px-6 pb-[72px] pt-6">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 class="text-[28px] font-semibold tracking-heading">Latest roles</h2>
      <a href="/jobs/" class="text-[15px] font-medium text-brand hover:text-brand-dark">See all {jobs.length} →</a>
    </div>
    <JobList>
      {recent.map((j) => (
        <JobCard
          href={`/jobs/${j.slug}/`}
          title={j.data.title}
          company={j.data.company}
          location={j.data.location}
          remote={j.data.remote}
          func={j.data.function}
          level={j.data.level}
          salaryMin={j.data.salaryMin}
          salaryMax={j.data.salaryMax}
          postedAt={j.data.postedAt}
        />
      ))}
    </JobList>
  </section>

  <section class="mx-auto flex max-w-site flex-col gap-5 px-6 pb-[72px]">
    <div class="flex flex-col gap-1.5">
      <h2 class="text-[28px] font-semibold tracking-heading">Browse by role</h2>
      <p class="text-ink-600">Salary ranges, top employers and every open role for each discipline.</p>
    </div>
    <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(260px,1fr))]">
      {roleCards.map((f) => (
        <a href={`/jobs/function/${f.urlSlug}/`} class="flex flex-col gap-2.5 rounded-card border border-ink-200 bg-white p-[22px] transition-colors hover:border-ink-950">
          <span class="flex items-baseline justify-between gap-3 text-lg font-semibold tracking-[-0.015em]">
            <span>{f.label}</span>
            <span class="font-mono text-sm font-medium text-brand">{byFunction[f.slug]}</span>
          </span>
          <span class="font-mono text-[13px] text-ink-600">{k(f.salaryBand.min)}–{k(f.salaryBand.max)} typical</span>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto flex max-w-site flex-col gap-5 px-6 pb-[72px]">
    <div class="flex flex-col gap-1.5">
      <h2 class="text-[28px] font-semibold tracking-heading">Browse by city</h2>
      <p class="text-ink-600">Open roles in major US media markets, plus fully remote positions.</p>
    </div>
    <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(220px,1fr))]">
      {CITY_INTROS.map((c) => (
        <a href={`/jobs/city/${c.urlSlug}/`} class="flex flex-col gap-2.5 rounded-card border border-ink-200 bg-white p-[22px] transition-colors hover:border-ink-950">
          <span class="flex items-baseline justify-between gap-3 text-lg font-semibold tracking-[-0.015em]">
            <span>{c.label}</span>
            <span class="font-mono text-sm font-medium text-brand">{byCity[c.urlSlug]}</span>
          </span>
          <span class="font-mono text-[13px] text-ink-600">{k(c.salaryBand.min)}–{k(c.salaryBand.max)} typical</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
