---
import { FUNCTION_LABELS, LEVEL_LABELS, formatSalary, postedAgo } from "../lib/format";

interface Props {
  href: string;
  title: string;
  company: string;
  location: string;
  remote: "onsite" | "hybrid" | "remote";
  func: string;
  level: string;
  salaryMin?: number;
  salaryMax?: number;
  postedAt: Date;
  featured?: boolean;
}
const {
  href, title, company, location, remote, func, level,
  salaryMin, salaryMax, postedAt, featured,
} = Astro.props;
const salary = formatSalary(salaryMin, salaryMax);
const ago = postedAgo(postedAt);
const initial = company.trim().charAt(0).toUpperCase() || "·";
---
<a
  href={href}
  class="group flex items-start gap-4 border-b border-ink-100 px-4 py-4 transition-colors hover:bg-ink-50 sm:px-6 sm:py-5 md:items-center"
>
  <span
    class:list={[
      "flex h-11 w-11 shrink-0 items-center justify-center rounded-[10px] font-semibold",
      featured ? "bg-brand-tint text-brand-dark" : "bg-ink-100 text-ink-950",
    ]}
    aria-hidden="true"
  >{initial}</span>
  <span class="flex min-w-0 flex-1 flex-col gap-3 md:flex-row md:items-center md:gap-4">
    <span class="flex min-w-0 flex-col gap-1 md:flex-1">
      <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <span class="text-[17px] font-semibold leading-snug text-ink-950 group-hover:text-brand">{title}</span>
        {featured && <span class="shrink-0 rounded-full border border-brand-line bg-brand-tint px-2 py-0.5 font-mono text-[11px] uppercase tracking-wide text-brand-dark">Featured</span>}
      </span>
      <span class="text-[15px] text-ink-600">
        {company} · {location}{remote !== "onsite" && <span class="capitalize"> · {remote}</span>}
      </span>
    </span>
    <span class="flex items-center justify-between gap-3 md:contents">
      <span class="flex flex-wrap gap-1.5 text-xs">
        <span class="rounded-md bg-brand-tint px-2 py-1 text-brand-dark">{FUNCTION_LABELS[func] ?? func}</span>
        <span class="rounded-md bg-ink-100 px-2 py-1 text-ink-700">{LEVEL_LABELS[level] ?? level}</span>
      </span>
      <span class="flex shrink-0 flex-col items-end gap-0.5 text-right md:w-[150px]">
        <span class:list={["font-mono text-[15px] font-medium", salary ? "text-ink-950" : "text-ink-400"]}>{salary ?? "—"}</span>
        <span class="font-mono text-xs text-ink-500">{ago}</span>
      </span>
    </span>
  </span>
</a>
